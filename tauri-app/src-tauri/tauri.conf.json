{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-sync",
  "version": "0.1.0",
  "identifier": "com.agentsync.panel",
  "build": {
    "beforeBuildCommand": "node prepare.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": [
      "resources/server.mjs",
      "resources/sync.mjs",
      "resources/backup-agents.mjs",
      "resources/web/index.html",
      "resources/web/mdview.html",
      "resources/web/logo.png"
    ]
  }
}
